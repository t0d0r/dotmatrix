#!/bin/sh

# exclude these files from creating links (shared with dotmatrix-uninstall)
. "$(dirname "$0")/dotmatrix-exclude.sh"

usage() {
  echo "Please run this script from 'dotmatrix' directory!"
  echo "Usage:  ./bin/dotmatrix-install"
	exit
}

pwd=`pwd`
if [ `basename ${pwd}` != 'dotmatrix' ] ; then
  usage
fi

# self update
git pull

# host/client specific scripts, shipped encrypted (see bin/private-seal).
# They restore to their own paths, so ~/bin/<script> keeps working.
if [ -f private.tar.gz.gpg ]; then
  echo "===== private overlay ====="
  if ! command -v gpg > /dev/null; then
    echo "gpg not installed -- skipping, run bin/private-unseal later"
  else
    # -f is deliberately not passed: never clobber local edits unasked
    ./bin/private-unseal || echo "not unsealed -- run bin/private-unseal by hand"
  fi
fi

#for i in `find . -depth 1 -exec basename {} \;`; do
for i in `find . -maxdepth 1 -exec basename {} \;`; do
  echo "${i}" | grep -qE "${EXCLUDE}" && echo "skipping ${i}" && continue
  if [ -f ${HOME}/${i} -o -d ${HOME}/${i} -o -L  ${HOME}/${i} ]; then
    #echo "${HOME}/${i} already exists" && ls -ald ${HOME}/${i}
    ls -ald ${HOME}/${i} | awk '{ print $9,$10,$11 }' | grep -v ${pwd}
		continue
  fi
  ln -vs ${pwd}/$i ${HOME}/$i
done

# .config directory
if [ -d .config ]; then
	echo "===== .config/ ====="
	for i in `find .config -mindepth 1 -maxdepth 1 -type d`; do
	#	echo "> ${i}"
		if [ -d ${HOME}/${i} ] ; then
			echo "${HOME}/$i already exists"
			continue
		fi
		ln -vs ${pwd}/$i ${HOME}/$i
	done
fi

# dot.claude -> ~/.claude (link contents, not the directory itself)
if [ -d dot.claude ]; then
	echo "===== .claude/ ====="
	mkdir -p ${HOME}/.claude
	for i in `find dot.claude -mindepth 1 -maxdepth 1`; do
		name=`basename $i`
		target="${HOME}/.claude/${name}"
		if [ -f ${target} -o -d ${target} -o -L ${target} ]; then
			ls -ald ${target} | awk '{ print $9,$10,$11 }' | grep -v ${pwd}
			continue
		fi
		ln -vs ${pwd}/$i ${target}
	done
fi

# install/update vim plugins via vim-plug.
# Must run *after* the symlinks above: on a fresh machine ~/.vim does not
# exist until then, and vim would stop at "Press ENTER" on the missing rc,
# hanging the whole install. </dev/null and --not-a-term keep it from
# blocking even if something else goes wrong.
echo "===== vim-plug ====="
if ! command -v vim > /dev/null; then
	echo "vim not installed -- skipping plugin install"
elif [ ! -r ${HOME}/.vim/vim-plugrc ]; then
	echo "${HOME}/.vim/vim-plugrc not readable -- skipping plugin install"
else
	vim -u ${HOME}/.vim/vim-plugrc --noplugin --not-a-term \
		+PlugUpgrade +PlugInstall +PlugUpdate +qall < /dev/null ||
		echo "vim-plug step failed -- run it by hand"
fi
