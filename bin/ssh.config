#!/bin/bash
# Generate ~/.ssh/config from hosts/ and customers/ fragments.
#
# Site specific values (hostnames, publish URLs, admin account) are NOT in
# this file -- they live in ~/.ssh/.sshconfigrc, which is outside the repo
# and should be mode 600. See bin/ssh.config.rc.example for the format.
# Everything below degrades gracefully when a value is unset.

rc="${SSHCFG_RC:-$HOME/.ssh/.sshconfigrc}"
# shellcheck source=/dev/null
[ -r "$rc" ] && . "$rc"

: "${SSHCFG_HOST_ALIASES:=}"   # "short=canonical short=canonical ..."
: "${SSHCFG_PUBLISH_HOST:=}"   # only this host publishes keys
: "${SSHCFG_BASTION:=}"        # ProxyJump host, commented out on itself
: "${SSHCFG_KEYS_URL:=}"       # base URL the .pub files are served from
: "${SSHCFG_ADMIN_URL:=}"      # base URL the bootstrap scripts are served from
: "${SSHCFG_ADMIN_USER:=admin}"

base_path=`realpath ~/.ssh`
html_path=~/public_html/ssh-keys
add_admin_path=~/public_html/add-${SSHCFG_ADMIN_USER}

hostname=${1:-`hostname -s`}
# map a short name to its canonical one, if the rc file defines a mapping
for alias in ${SSHCFG_HOST_ALIASES}; do
  case ${alias} in
    "${hostname}="*)
      hostname="${alias#*=}"
      break
    ;;
  esac
done

relative_host_dir="hosts/$hostname"
customers_dir="customers"
absolute_config="${base_path}/${relative_host_dir}"

# functions
###############################################################################

pushd () {
  command pushd "$@" > /dev/null
}

popd () {
  command popd "$@" > /dev/null
}

can_i_run_on () {
  if [ -n "${SSHCFG_PUBLISH_HOST}" ] && [ "$1" = "${SSHCFG_PUBLISH_HOST}" ]; then
    echo yes
  else
    echo no
  fi
}

public_url_for_keys () {
  suffix=$1;
  echo "${SSHCFG_KEYS_URL}/${suffix}"
}

public_url_for_admin () {
  suffix=$1;
  echo "${SSHCFG_ADMIN_URL}/${suffix}"
}

# TODO: ssh_copy_id

do_public_html_links () {
  # TODO: to create cleanup logic for ~/public_html/ssh-keys
  if [ `can_i_run_on ${hostname}` = 'yes' ]; then
    echo "Sharing public keys via public_html..."
    pushd ${base_path}
    for public_key in `find . -type f -name "*.pub"`; do
      # create ssh-keys/ content
      key_name=`basename ${public_key}`
      key_path=`dirname ${public_key}`
      key_dir=`basename ${key_path}`
      mkdir -p "${html_path}/${key_dir}"
      cp  $public_key "${html_path}/${key_dir}"
      chmod -R a+r "${html_path}/${key_dir}"
      if [ $? -eq 0 ]; then
        public_url_for_keys "${key_dir}/${key_name}"
      fi
      # create admin-account bootstrap content
      u="${SSHCFG_ADMIN_USER}"
      mkdir -p ${add_admin_path}
      script_name="$add_admin_path/${key_dir}.sh"
      (
        echo "useradd -m -G sudo ${u}"
        echo "echo '${u}     ALL=(root) NOPASSWD: ALL' > /etc/sudoers.d/${u}"
        echo "chmod 600 /etc/sudoers.d/${u}"
        echo "mkdir ~${u}/.ssh"
        echo "echo $(cat ${public_key}) > ~${u}/.ssh/authorized_keys"
        echo "chown -R ${u}:${u} ~${u}/.ssh; chmod 700 ~${u}/.ssh; chmod 600 ~${u}/.ssh/* "
      ) > ${script_name}
      if [ $? -eq 0 ]; then
        public_url_for_admin "${key_dir}.sh"
      fi
    done
    echo "done."
    popd
  else
    echo "Skipping do_public_html_links()..."
  fi
}

do_git_pull () {
  pushd ${base_path}
  git pull
  git status
  popd
}

# rewrite some hosts to their relative paths
do_cleanup_and_rewrite () {
  pushd $base_path || exit 1
  # cleanup
  find $base_path/ -type l -delete

  for filename in `find ${relative_host_dir} -type f `; do
    ln -sfv $filename
  done
  # remove host config file, content of it will be included later
  rm -f config.template

  includes_tmp=$(mktemp)

  echo "Generating composite ${base_path}/config.template:"
  for c in `find ${customers_dir} -type f -name "config"`; do
    echo " ${c}..."
    grep -i "^Include " "$c" >> "$includes_tmp"
    cat >> ${base_path}/config.template <<__EOF__
### `dirname ${c}`
`cat $c | egrep -iv "^#|^$|^Include "`

__EOF__
  done

  echo "### ${relative_host_dir}/config" >> ${base_path}/config.template
  grep -i "^Include " "${relative_host_dir}/config" >> "$includes_tmp"
  cat ${relative_host_dir}/config | egrep -iv "^#|^$|^Include " >> ${base_path}/config.template
  echo "### config.default" >> ${base_path}/config.template
  grep -i "^Include " "config.default" >> "$includes_tmp"
  cat config.default | egrep -iv "^#|^$|^Include " >> ${base_path}/config.template

  # append collected Include directives at the bottom
  if [ -s "$includes_tmp" ]; then
    printf "\n### includes\n" >> ${base_path}/config.template
    awk '!seen[$0]++' "$includes_tmp" >> ${base_path}/config.template
  fi
  rm -f "$includes_tmp"

  # don't proxyjump itself
  if [ -n "${SSHCFG_BASTION}" ] && [ `can_i_run_on ${hostname}` = 'yes' ]; then
    # escape the hostname for use inside the sed address
    bastion_re=`printf '%s' "${SSHCFG_BASTION}" | sed 's/[.[\*^$\/]/\\\\&/g'`
    sed -i.bak "/^\tProxyJump ${bastion_re}\$/s/^/#/" ${base_path}/config.template && rm -f ${base_path}/config.template.bak
  fi

  # Validate the generated config.template
  if ssh -F ${base_path}/config.template -G localhost > /dev/null 2>&1; then
    mv ${base_path}/config.template ${base_path}/config
    echo "Config validated and moved to config."
  else
    echo "Error: Generated config.template is invalid. Not replacing config."
    exit 1
  fi
  popd
}

do_fix_perm () {
  pushd ${base_path}
  echo Fixing permitions...
  chmod 700 $base_path
  # force perm to 600 for all files
  find $base_path -type f -exec chmod 600 {} \;
  # force perm to 700 for all directories
  find $base_path -type d -exec chmod 700 {} \;
  popd
}

# MAIN
###############################################################################

do_git_pull
do_cleanup_and_rewrite
do_fix_perm
do_public_html_links
