# Only formats handled by small, well-maintained converters are rendered
# automatically when a message is opened. Office documents, RTF and
# application/octet-stream (which mutt.octet.filter dispatches to latex2html,
# unrar, unarj, rpm, dpkg, ... based on the sender-chosen filename) are
# viewed on demand from the attachment menu instead.
auto_view text/html
auto_view application/x-pgp-message
auto_view image/*
auto_view application/pdf
