# folder-hook todor.dragnev@imap.gmail.com:993/ 'source ~/.mutt/acc/gmail'
#
# # tcv
# source ~/.mutt/acc/tcv
# folder-hook user@example.org@imap.example.org:993/ 'source ~/.mutt/acc/example'
#
# # bst
# source ~/.mutt/acc/bst
# folder-hook user@example.com@imap.example.com:993/ 'source ~/.mutt/acc/example2'
#
# Live account bindings live in ~/.mutt/private.rc (not in the repo -- it
# names real addresses). Sourced through a command so mutt does not error
# out when the file is absent, e.g. on a fresh clone before unsealing.
source "test -r ~/.mutt/private.rc && cat ~/.mutt/private.rc; true|"
